{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-skills.invalid/independent-review-result-v1.schema.json",
  "title": "Independent Review Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewRecordId", "executionId", "reviewer", "attestation", "assuranceLevel", "baseCommit", "headCommit", "manifestDigest", "startedAt", "completedAt", "findings", "status", "unavailableCode"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "reviewRecordId": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["type", "identity", "adapter"], "properties": {"type": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1}}},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["ref", "nonInteractive", "isolatedContext", "freshContext", "readOnly"], "properties": {"ref": {"type": "string", "minLength": 1}, "nonInteractive": {"type": "boolean"}, "isolatedContext": {"type": "boolean"}, "freshContext": {"type": "boolean"}, "readOnly": {"type": "boolean"}}},
    "assuranceLevel": {"enum": ["strict-isolated", "authorized-degraded"]},
    "capabilityLedger": {"type": "object", "additionalProperties": false, "required": ["enforced", "unavailable", "instructionConstrained"], "properties": {"enforced": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "unavailable": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "instructionConstrained": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "strictUnavailable": {"type": "object", "additionalProperties": false, "required": ["reviewRecordId", "executionId", "adapter", "status", "unavailableCode", "baseCommit", "headCommit", "manifestDigest"], "properties": {"reviewRecordId": {"type": "string", "minLength": 1}, "executionId": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1}, "status": {"const": "unavailable"}, "unavailableCode": {"type": "string", "minLength": 1}, "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "degradedAuthorization": {"type": "object", "additionalProperties": false, "required": ["change", "transition", "expiresAt", "riskReason", "fallbackBoundary"], "properties": {"change": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "transition": {"enum": ["merge-pr"]}, "expiresAt": {"type": "string", "format": "date-time"}, "riskReason": {"type": "string", "minLength": 1}, "fallbackBoundary": {"const": "fresh-separated-reviewer-only"}}},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "startedAt": {"type": "string", "format": "date-time"}, "completedAt": {"type": "string", "format": "date-time"},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "evidence", "recommendation"], "properties": {"id": {"type": "string", "minLength": 1}, "severity": {"enum": ["blocker", "high", "objective-fix", "warning", "false-positive"]}, "evidence": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}}},
    "status": {"enum": ["passed", "failed", "unavailable"]},
    "unavailableCode": {"type": "string"}
  },
  "allOf": [
    {"if": {"required": ["assuranceLevel", "status"], "properties": {"assuranceLevel": {"const": "strict-isolated"}, "status": {"enum": ["passed", "failed"]}}}, "then": {"properties": {"attestation": {"properties": {"nonInteractive": {"const": true}, "isolatedContext": {"const": true}, "freshContext": {"const": true}, "readOnly": {"const": true}}}}}},
    {"if": {"required": ["assuranceLevel", "status"], "properties": {"assuranceLevel": {"const": "strict-isolated"}, "status": {"const": "unavailable"}}}, "then": {"properties": {"attestation": {"properties": {"nonInteractive": {"const": false}, "isolatedContext": {"const": false}, "freshContext": {"const": false}, "readOnly": {"const": false}}}}}},
    {"if": {"properties": {"assuranceLevel": {"const": "authorized-degraded"}}}, "then": {"required": ["capabilityLedger", "strictUnavailable", "degradedAuthorization"], "properties": {"attestation": {"properties": {"nonInteractive": {"const": true}, "freshContext": {"const": true}}}}}},
    {"if": {"properties": {"status": {"const": "passed"}}}, "then": {"properties": {"findings": {"items": {"properties": {"severity": {"enum": ["warning", "false-positive"]}}}}}}}
  ]
}
