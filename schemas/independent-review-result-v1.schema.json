{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-skills.invalid/independent-review-result-v1.schema.json",
  "title": "Independent Review Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "reviewRecordId", "executionId", "reviewer", "attestation", "baseCommit", "headCommit", "manifestDigest", "startedAt", "completedAt", "findings", "status", "unavailableCode"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "reviewRecordId": {"type": "string", "minLength": 1},
    "executionId": {"type": "string", "minLength": 1},
    "reviewer": {"type": "object", "additionalProperties": false, "required": ["type", "identity", "adapter"], "properties": {"type": {"type": "string", "minLength": 1}, "identity": {"type": "string", "minLength": 1}, "adapter": {"type": "string", "minLength": 1}}},
    "attestation": {"type": "object", "additionalProperties": false, "required": ["ref", "nonInteractive", "isolatedContext", "freshContext", "readOnly"], "properties": {"ref": {"type": "string", "minLength": 1}, "nonInteractive": {"type": "boolean"}, "isolatedContext": {"type": "boolean"}, "freshContext": {"type": "boolean"}, "readOnly": {"type": "boolean"}}},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "startedAt": {"type": "string", "format": "date-time"}, "completedAt": {"type": "string", "format": "date-time"},
    "findings": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["id", "severity", "evidence", "recommendation"], "properties": {"id": {"type": "string", "minLength": 1}, "severity": {"enum": ["blocker", "high", "objective-fix", "warning", "false-positive"]}, "evidence": {"type": "string", "minLength": 1}, "recommendation": {"type": "string", "minLength": 1}}}},
    "status": {"enum": ["passed", "failed", "unavailable"]},
    "unavailableCode": {"type": "string"}
  }
}
