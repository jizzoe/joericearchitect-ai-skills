{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ai-skills.invalid/independent-review-package-v1.schema.json",
  "title": "Independent Review Package v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baseCommit", "headCommit", "diff", "artifacts", "validationEvidence", "manifestDigest"],
  "properties": {
    "schemaVersion": {"const": 1},
    "baseCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "headCommit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "diff": {"type": "string", "minLength": 1},
    "artifacts": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}}}},
    "validationEvidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "manifestDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
